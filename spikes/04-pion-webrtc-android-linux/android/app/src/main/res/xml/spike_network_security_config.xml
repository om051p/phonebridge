<?xml version="1.0" encoding="utf-8"?>
<!--
  Spike 04 ONLY.

  The spike-local signaling exchange POSTs an SDP offer as plain HTTP to the
  Linux receiver over the private LAN. Android (targetSdk 28+) denies cleartext
  by default, which silently failed the first end-to-end run with:

      java.io.IOException: Cleartext HTTP traffic to <host> not permitted

  This config re-enables cleartext *only* for RFC1918 address literals, so the
  allowance is explicit and cannot be mistaken for a production posture.
  Production signaling is expected to ride the DEC-019 ownership boundary
  (Go owns transport) and must never be unauthenticated plaintext HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.236</domain>
        <domain includeSubdomains="false">192.168.0.125</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
