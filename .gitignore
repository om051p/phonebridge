# Go — NOTE: generated protobuf code under core/pkg/protocol/ IS committed.
# See docs/decisions.md DEC-015 and proto/buf.gen.yaml. Do not re-ignore it:
# the CI drift gate depends on generated code being tracked.

# Dart / Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.pub-cache/
.pub/
ui/.dart_tool/
ui/build/
ui/.flutter-plugins*

# Android
android/.gradle/
android/app/build/
android/build/
android/local.properties
*.keystore
*.jks

# Android native artifacts — DEC-019 c-shared JNI library (built by
# `make -C core android-lib` into the AGP source set, 14–15 MB per ABI)
# plus cgo's generated header. Regenerate from core/cmd/android; never commit.
android/app/src/main/jniLibs/**/*.so
android/app/src/main/jniLibs/**/*.h
# AGP/CMake native build cache
android/app/.cxx/
# Flutter-generated plugin registrant (regenerated on pub get / build)
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Buf / protoc
proto/.buf/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*~

# Local agent tooling state (machine-local, not product sources)
.agents/
.freebuff/

# Spikes — build outputs and regenerable per-run evidence.
# Spike trees are self-contained; rebuild with the spike Makefile
# (spikes/<id>/make build|perf). Never commit spike binaries.
spikes/*/go/bin/
spikes/*/go/tools/
spikes/*/results/
spikes/*/android/.gradle/
spikes/*/android/local.properties
# Spike JNI libraries (cgo c-shared outputs, ~14 MB/ABI) and the Linux
# receiver built by `make receiver` (~15 MB). Sources sit next to them.
spikes/*/android/app/src/main/jniLibs/
spikes/*/tools/spike*-receiver

# Compiled ipcdrv diagnostic driver (go build -o core/ipcdrv ./core/cmd/ipcdrv).
# Source lives in core/cmd/ipcdrv/; the ~16 MB binary is never committed.
/core/ipcdrv
*.tar.gz
__pycache__/
*.pyc

